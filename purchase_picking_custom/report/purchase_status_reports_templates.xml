<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════
         Shipments Status Report (PDF)
         ═══════════════════════════════════════════════════ -->
    <template id="report_purchase_shipment_status_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Shipments Status Report</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Supplier</th>
                                <th>Invoice Number</th>
                                <th>Loading Date</th>
                                <th>Actual Value + Freight</th>
                                <th>Shipment Date</th>
                                <th>ETD</th>
                                <th>ETA</th>
                                <th>Shipping Line</th>
                                <th>Shipment Status</th>
                                <th>Free Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="line">
                                <td><span t-esc="line.sequence"/></td>
                                <td><span t-field="line.partner_id"/></td>
                                <td><span t-esc="line.invoice_number"/></td>
                                <td><span t-field="line.loading_date"/></td>
                                <td>
                                    <span t-field="line.amount_total"
                                          t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                </td>
                                <td><span t-field="line.shipment_date"/></td>
                                <td><span t-field="line.etd"/></td>
                                <td><span t-field="line.eta"/></td>
                                <td><span t-esc="line.shipping_line"/></td>
                                <td><span t-field="line.shipment_status"/></td>
                                <td><span t-esc="line.free_days"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_purchase_shipment_status" model="ir.actions.report">
        <field name="name">Shipments Status Report</field>
        <field name="model">purchase.shipment.status.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_picking_custom.report_purchase_shipment_status_document</field>
        <field name="report_file">purchase_picking_custom.report_purchase_shipment_status_document</field>
        <field name="print_report_name">'Shipments Status Report'</field>
        <field name="binding_model_id" ref="model_purchase_shipment_status_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         Items Status Report (PDF)
         ═══════════════════════════════════════════════════ -->
    <template id="report_purchase_items_status_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Items Status Report</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Product Name</th>
                                <th>Under Preparation</th>
                                <th>In Transit</th>
                                <th>Under Clearance</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="line">
                                <td><span t-esc="line.sequence"/></td>
                                <td><span t-field="line.product_id"/></td>
                                <td><span t-esc="line.under_preparation_qty"/></td>
                                <td><span t-esc="line.in_transit_qty"/></td>
                                <td><span t-esc="line.under_clearance_qty"/></td>
                                <td><span t-esc="line.stock_qty"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_purchase_items_status" model="ir.actions.report">
        <field name="name">Items Status Report</field>
        <field name="model">purchase.items.status.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_picking_custom.report_purchase_items_status_document</field>
        <field name="report_file">purchase_picking_custom.report_purchase_items_status_document</field>
        <field name="print_report_name">'Items Status Report'</field>
        <field name="binding_model_id" ref="model_purchase_items_status_report"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
