<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         FORM VIEW — add Internal Transfer fields
    ===================================================================== -->
    <record id="view_account_payment_form_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.form.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Expose the computed destination journal list so the domain works -->
            <field name="available_journal_ids" position="after">
                <field name="available_destination_journal_ids" invisible="1"/>
            </field>

            <!-- Source journal label changes to "Source Journal" for clarity -->
            <field name="journal_id" position="attributes">
                <attribute name="string_as_label">Source Journal</attribute>
            </field>

            <!-- Add is_internal_transfer checkbox + destination journal -->
            <field name="journal_id" position="after">
                <field name="is_internal_transfer"
                       string="Internal Transfer"
                       readonly="state != 'draft'"/>
                <field name="destination_journal_id"
                       invisible="not is_internal_transfer"
                       required="is_internal_transfer and state == 'draft'"
                       readonly="state != 'draft'"
                       domain="[('id', 'in', available_destination_journal_ids)]"
                       options="{'no_create': True, 'no_open': True}"
                       context="{'show_company': True}"/>
            </field>

            <!-- Hide payment_type radio for internal transfers (always outbound) -->
            <field name="payment_type" position="attributes">
                <attribute name="invisible">is_internal_transfer</attribute>
            </field>

            <!-- Hide customer partner field when internal transfer -->
            <xpath expr="//field[@name='partner_id'][contains(@invisible, 'customer')]" position="attributes">
                <attribute name="invisible">partner_type != 'customer' or is_internal_transfer</attribute>
            </xpath>

            <!-- Hide vendor partner field when internal transfer -->
            <xpath expr="//field[@name='partner_id'][contains(@invisible, 'supplier')]" position="attributes">
                <attribute name="invisible">partner_type != 'supplier' or is_internal_transfer</attribute>
            </xpath>

            <!-- Stat button: jump to the paired payment on the other side -->
            <div name="button_box" position="inside">
                <button name="button_open_paired_transfer"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="not is_internal_transfer or not paired_internal_transfer_payment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Paired Transfer</span>
                    </div>
                </button>
            </div>

        </field>
    </record>

    <!-- =====================================================================
         SEARCH VIEW — add Internal Transfers filter
    ===================================================================== -->
    <record id="view_account_payment_search_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.search.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="outbound_filter" position="after">
                <separator/>
                <filter string="Internal Transfers"
                        name="transfers_filter"
                        domain="[('is_internal_transfer', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- =====================================================================
         LIST VIEW — destination journal + transfer flag columns (opt-in)
    ===================================================================== -->
    <record id="view_account_payment_tree_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.list.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="destination_journal_id"
                       string="Dest. Journal"
                       optional="hide"/>
                <field name="is_internal_transfer"
                       string="Transfer"
                       optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
