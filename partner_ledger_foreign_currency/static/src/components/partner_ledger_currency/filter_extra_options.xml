<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
        Extend the Partner Ledger "Options" dropdown with a
        "Display Foreign Currencies" toggle.
        When active the report groups each partner's lines by the
        transaction currency and shows amounts in that currency.
    -->
    <t t-inherit="account_reports.PartnerLedgerReportFilterExtraOptions" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(@class, 'filter_show_all_hook')]" position="before">
            <DropdownItem
                t-if="'display_foreign_currency' in controller.options"
                class="{ 'selected': controller.options.display_foreign_currency }"
                onSelected="() => this.filterClicked({ optionKey: 'display_foreign_currency', reload: true })"
                closingMode="'none'"
            >
                Display Foreign Currencies
            </DropdownItem>
        </xpath>
    </t>
</templates>
