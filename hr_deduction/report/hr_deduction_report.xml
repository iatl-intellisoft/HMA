        <record id="action_deduction_report" model="ir.actions.report">
            <field name="name">Deduction Form</field>
            <field name="model">hr.deduction.batch</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_deduction.report_deduction</field>
            <field name="report_file">hr_deduction.report_deduction</field>
            <field name="print_report_name">'Deduction Form'</field>
            <field name="binding_model_id" ref="model_hr_deduction_batch"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_deduction">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div id="template_introduction_id" t-field="o.deduction_website_description"
                             class='oe_no_empty'>
                        </div>
                        <br/>
                        <br/>
                        <table class="table table-bordered">
                            <t t-foreach="o.getStateTriggers('hr.deduction.batch',o.id,['confirm','approve'])"
                               t-as="track">
                                <tr>
                                    <t t-if="track['state'] == 'confirm'">
                                        <td>
                                            <strong>Confirmed By</strong>
                                        </td>
                                        <td>
                                            <t t-esc="track['username']"/>
                                        </td>
                                        <td>
                                            <strong>At</strong>
                                        </td>
                                        <td>
                                            <t t-esc="track['date']"/>
                                        </td>
                                    </t>
                                </tr>
                                <tr>
                                    <t t-if="track['state'] == 'approve'">
                                        <td>
                                            <strong>Approved By</strong>
                                        </td>
                                        <td>
                                            <t t-esc="track['username']"/>
                                        </td>
                                        <td>
                                            <strong>At</strong>
                                        </td>
                                        <td>
                                            <t t-esc="track['date']"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </table>
                    </t>
                </t>
            </t>
        </template>
</odoo>
