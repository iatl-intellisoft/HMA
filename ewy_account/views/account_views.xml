<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_form_inherited" model="ir.ui.view">
        <field name="name">view.account.form.inherited</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page[@name='accounting']/group/group[2]/field[@name='company_ids']"
                   position="after">
                <field name="second_currency_id"/>
            </xpath>
        </field>
    </record>
</odoo>