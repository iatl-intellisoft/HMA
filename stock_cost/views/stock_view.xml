        <record id="stock_valuation_layer_form_view" model="ir.ui.view">
            <field name="name">stock.valuation.layer.form</field>
            <field name="model">stock.valuation.layer</field>
            <field name="inherit_id" ref="stock_account.stock_valuation_layer_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[1]/group" position="after">
                    <group>
                    <field name="foreign_price_unit"
                            class="float-left" options="{'currency_field': 'force_currency_id'}"/>
                    <field name="foreign_value" widget="monetary" options="{'currency_field': 'force_currency_id'}"/>
                    <field name="force_currency_id" invisible="0"/>        
                        </group>
                </xpath>
            </field>
        </record>


        <record id="stock_valuation_layer_list_view" model="ir.ui.view">
            <field name="name">stock.valuation.layer.list</field>
            <field name="model">stock.valuation.layer</field>
            <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='value']" position="after">
                    <field name="foreign_price_unit" options="{'currency_field': 'force_currency_id'}"/>
                    <field name="foreign_value" widget="monetary" options="{'currency_field': 'force_currency_id'}" sum="Total"/>
                    <field name="force_currency_id" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='value']" position="before">
                    <field name="unit_cost"/>
                </xpath>
            </field>
        </record>

         <record id="view_move_picking_form" model="ir.ui.view">
            <field name="name">stock.move.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                    <field name="price_unit" readonly="1" groups="stock.group_stock_manager"/>
                    <field name="foreign_price_unit" readonly="1" groups="stock.group_stock_manager"/>
                    <!-- <field name="value" readonly="1" groups="stock.group_stock_manager" invisible="1"/>
                    <field name="remaining_value" readonly="1" groups="stock.group_stock_manager" invisible="1"/>
                    <field name="remaining_qty" readonly="1" groups="stock.group_stock_manager" invisible="1"/> -->
                </xpath>
            </field>
        </record>

        <record id="view_move_form" model="ir.ui.view">
            <field name="name">stock.move.form</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="price_unit" readonly="1" groups="stock.group_stock_manager"/>
                    <field name="foreign_price_unit" readonly="1" groups="stock.group_stock_manager"/>
                    <!-- <field name="value" readonly="1" groups="stock.group_stock_manager" invisible="1"/> -->
                    <!-- <field name="remaining_value" readonly="1" groups="stock.group_stock_manager" invisible="1"/> -->
                    <!-- <field name="remaining_qty" readonly="1" groups="stock.group_stock_manager" invisible="1"/> -->
                </xpath>
            </field>
        </record>

        <record id="view_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="after">
                    <field name="accounting_date" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Stock Quant-->
        <record model="ir.ui.view" id="view_stock_quant_list_inherit">
        <field name="name">stock.quant.list.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock_account.view_stock_quant_tree_inherit"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="after">
                <field name="force_currency_id" column_invisible="1"/>
                <field name="foreign_value"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_stock_quant_list_editable_inherit">
        <field name="name">stock.quant.list.editable.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock_account.view_stock_quant_tree_editable_inherit"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="after">
                <field name="force_currency_id" invisible="1"/>
                <field name="foreign_value"/>
            </xpath>
        </field>
    </record>


    </data>
</odoo>
