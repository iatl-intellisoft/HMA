<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Show the Exchange Rate field on the journal entry form header,
            only for journal entries (move_type = 'entry').
            Placed in header_right_group after the Accounting Date field.
        -->
        <record id="view_move_form_custom_rate" model="ir.ui.view">
            <field name="name">account.move.form.custom.rate</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="after">
                    <label for="custom_rate"
                           string="Exchange Rate"
                           invisible="move_type != 'entry'"/>
                    <field name="custom_rate"
                           digits="[16, 6]"
                           invisible="move_type != 'entry'"
                           readonly="state != 'draft'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
