<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Add the custom exchange rate column to the Journal Items list
            inside the journal entry form (account.move).

            The column is:
            - Visible by default (optional="show")
            - Hidden automatically for invoices/bills (column_invisible)
            - Shown after the "Amount in Currency" column
            - Only relevant when base.group_multi_currency is active, but
              we show it unconditionally so users can set a rate before
              picking the currency.
        -->
        <record id="view_move_form_custom_rate" model="ir.ui.view">
            <field name="name">account.move.form.custom.rate</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/list/field[@name='amount_currency']" position="after">
                    <field name="custom_rate"
                           string="Rate"
                           optional="show"
                           digits="[16, 6]"
                           column_invisible="parent.move_type != 'entry'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
