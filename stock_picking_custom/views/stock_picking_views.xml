<odoo> 
    <record id="view_picking_form_inherit_vehicle" model="ir.ui.view">
        <field name="name">stock.picking.form.vehicle</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">  
                <field name="delivery_amount"/>  
                <field name="delivered_cartons"/>    
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">  
                <field name="national_id"/>  
                <field name="vat_id"/>  
                <field name="phone"/> 
            </xpath>  
            <xpath expr="//field[@name='origin']" position="after">
                <field name="handling_price"/>  
                <field name="handling_amount"/>   
            </xpath> 

        </field>
    </record>
 
    <record id="res_config_settings_view_form_inherit_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock</field>
        <field name="model">res.config.settings</field> 
        <field name="inherit_id"  ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- XPath targets the Operations block inside the Inventory page -->
            <xpath expr="//setting[@id='production_lot']" position="after">
                <setting>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="handling_price_default_value" string="سعر العتالة الافتراضي"/>
                            <div class="content-group">
                                <field name="handling_price_default_value"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </arch>
    </record>
 
 
</odoo> 
